# Orya Halo gateway configuration.
#
# Copy to .env (never commit that file) or set these in the environment.
# Every variable is optional: with none set the gateway listens on
# 0.0.0.0:8787 and uses the keyless feeds. Values shown are the defaults.

# --- Listening ---------------------------------------------------------------

# Address and port to listen on. PORT, when set, overrides the port.
BIND_ADDR=0.0.0.0:8787
# PORT=8787

# Origins allowed to use the HTTP API and open a stream, comma-separated,
# for example https://halo.example.org. Unset allows any localhost origin
# (for development). Use * to allow every origin.
# ALLOWED_ORIGINS=https://halo.example.org

# Set to true only behind a proxy you control (Fly.io, Render, a load
# balancer): the per-address limit then uses CLIENT_IP_HEADER, or the first
# X-Forwarded-For entry when that header is missing.
TRUST_PROXY=false
# The proxy's own header for the visitor's address: Fly-Client-IP on Fly.io,
# True-Client-IP on Render (set by Cloudflare, so a client cannot forge it).
CLIENT_IP_HEADER=fly-client-ip

# --- Protocol timing ---------------------------------------------------------

# Milliseconds between fan-out ticks. Sent to clients in hello.
TICK_MS=1000
# How often each entity is re-sent to whole-world subscribers.
WORLD_CADENCE_MS=5000
# Density frames: at most this often, and only when counts changed.
DENSITY_INTERVAL_MS=5000
# H3 resolution of density cells: 1, 2 or 3.
DENSITY_RES=2
STATS_INTERVAL_MS=1000
# Most cells accepted in one subscription.
MAX_CELLS=2000

# --- Client limits -----------------------------------------------------------

MAX_CLIENTS=2000
MAX_CLIENTS_PER_IP=8
# Close a connection that has been silent this long (clients ping every 15 s).
IDLE_TIMEOUT_S=60
# Server-side WebSocket ping interval.
PING_INTERVAL_S=20
# Largest client message, bytes. 2000 cell ids are about 40 KB.
MAX_MESSAGE_BYTES=131072
# Frames queued per client before deltas are dropped and the client is
# resynchronised with a FULL frame.
CLIENT_QUEUE_FRAMES=64
MAX_CLIENT_MESSAGES_PER_10S=60

# --- Frame compression (connections that ask with ?z=1) -----------------------

# Bodies smaller than this are sent as they are.
COMPRESS_MIN_BYTES=512
# DEFLATE level 1 to 9. Level 1 is within three points of level 9 on these
# frames and four to fifteen times faster.
COMPRESS_LEVEL=1

# --- World state -------------------------------------------------------------

# Drop an aircraft this long after its last report.
AIRCRAFT_TTL_S=90
# Feeds that revisit an area slowly ask for longer; this is the cap.
AIRCRAFT_MAX_TTL_S=900
# Flag a position as stale once it is this old (the app stops extrapolating at 45 s).
AIRCRAFT_STALE_S=45
MAX_AIRCRAFT=100000
AIRCRAFT_TRACK_POINTS=32
AIRCRAFT_TRACK_INTERVAL_S=15

SHIP_TTL_S=1200
SHIP_MAX_TTL_S=3600
SHIP_STALE_S=600
MAX_SHIPS=300000
SHIP_TRACK_POINTS=16
SHIP_TRACK_INTERVAL_S=120

# --- Upstream feeds ----------------------------------------------------------

# Which feeds to run, comma-separated. Unset runs the defaults:
# adsb-lol, digitraffic, aisstream (aisstream idles without a key).
# Others, off unless listed: adsb-lol-reapi, adsb-fi. See README.md for terms.
# UPSTREAMS=adsb-lol,digitraffic,aisstream

# User-Agent for upstream HTTP requests. Requests to CelesTrak add a short
# description of the satellite cache to it. Put nothing personal here.
# HTTP_USER_AGENT=orya-halo-gateway/0.1.0

# adsb.lol (ODbL). Works without a key at 500 requests a day per IP address.
# A key raises that: ad-hoc 1,000 a day, feeder 7,200 a day.
# ADSBLOL_API_KEY=
# Requests per day to budget for (10 or more). Default 500 without a key,
# 1000 with one; set 7200 for a feeder key. The gateway never sends more than
# this in any 24 hours: a tenth may go out in a burst, the rest is spread
# evenly over the day, and nothing is spent while nobody watches aircraft.
# ADSBLOL_DAILY_QUOTA=500
# Closest spacing between requests, milliseconds. Default 10000 without a key
# (unkeyed bursts are refused above about ten a minute), 2000 with one.
# ADSBLOL_MIN_INTERVAL_MS=10000
# Where the request budget is kept between runs, so that a restart carries on
# with what is left instead of a fresh allowance. Default: orya-halo-gateway/
# adsb-lol-budget.json under the system temporary directory. Point it at a
# volume if the temporary directory does not survive a redeploy. "off" keeps
# the budget in memory only (every restart then has a new burst to spend).
# ADSBLOL_BUDGET_FILE=/var/lib/orya-halo/adsb-lol-budget.json
# Whether a first run with no saved budget may spend a burst (a tenth of the
# day) at once. Set to false on hosts that wipe their disk on every restart
# (Render's free tier): each start is then empty and restarts can never add
# up to more than the daily allowance; aircraft appear within a few minutes.
ADSBLOL_FIRST_BURST=true

# adsb.lol re-api: the whole world in one request, twice a minute. Only
# answered for the IP address of a station that feeds adsb.lol. Enable with
# UPSTREAMS=adsb-lol-reapi,... on such a machine.
ADSBLOL_REAPI_URL=https://re-api.adsb.lol/?all_with_pos
ADSBLOL_REAPI_INTERVAL_S=30

# adsb.fi open data: personal, non-commercial use only. Off by default; list
# adsb-fi in UPSTREAMS only on a private instance or with adsb.fi's permission.
# One request a second is the documented limit.
ADSBFI_MIN_INTERVAL_MS=1100

# Aircraft scheduler: how often an area somebody is watching is refreshed, how
# often the rest is revisited (both as fast as the request budget allows), and
# the query radius in nautical miles (250 is the providers' maximum).
AIRCRAFT_HOT_INTERVAL_S=5
AIRCRAFT_BACKGROUND_INTERVAL_S=30
AIRCRAFT_TILE_RADIUS_NM=250

# AISStream.io: ships worldwide. Free key from https://aisstream.io (GitHub
# sign-in). Without it the ships layer shows only the keyless coverage.
# AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream

# Digitraffic (Fintraffic, CC BY 4.0): ships in Finnish waters, no key. The
# service asks clients to name their application in this header; do not put
# personal information in it.
DIGITRAFFIC_USER=orya-halo-gateway
DIGITRAFFIC_MQTT_URL=wss://meri.digitraffic.fi:443/mqtt
DIGITRAFFIC_REST_URL=https://meri.digitraffic.fi

# Look up a flight's origin and destination for the detail endpoint
# (Virtual Radar Server standing data, CC0).
ROUTES_ENABLED=true

# --- Wildfire proxy ----------------------------------------------------------

# NASA FIRMS active fires, served to the web app at
# /v1/proxy/firms/{source}/world/{days} so the key stays on the server.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it the endpoint answers 503 "needs_key" and the fire layer says so.
# FIRMS_MAP_KEY=
# How long a fetched file is shared before FIRMS is asked again, seconds
# (at least 60). The key allows 5,000 transactions per ten minutes; at the
# default the proxy needs at most 20 requests in twenty minutes.
FIRMS_CACHE_TTL_S=1200
# Largest file accepted from FIRMS, bytes (48 MiB).
FIRMS_MAX_BYTES=50331648
# Where FIRMS is reached. Only tests change this.
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# --- Satellite element cache --------------------------------------------------

# CelesTrak GP elements, served to the web app at
# /v1/proxy/celestrak/{group}.csv (active, or stations for testing). CelesTrak
# serves each group once per update (every 2 hours) to each IP address and
# refuses repeats with HTTP 403, so every visitor behind one address shares
# this one copy. Nothing is fetched until a client asks.
# Seconds a copy is served before CelesTrak is asked again, and the least time
# between two requests for a group, whatever the answer was (7200 or more).
CELESTRAK_REFRESH_S=7200
# How long the last good copy stands in while CelesTrak refuses or cannot be
# reached, seconds (7 days). Older elements put satellites too far off.
CELESTRAK_MAX_STALE_S=604800
# Largest file accepted from CelesTrak, bytes (16 MiB; the active group is about 2.5 MB).
CELESTRAK_MAX_BYTES=16777216
# Where the last good copies and the time of the last request are kept, so a
# restart does not spend another download. Default: orya-halo-gateway/celestrak
# under the system temporary directory. "off" keeps them in memory only.
# CELESTRAK_CACHE_DIR=/var/lib/orya-halo/celestrak
# Where CelesTrak is reached. Only tests change this.
CELESTRAK_BASE_URL=https://celestrak.org

# --- Mock mode ---------------------------------------------------------------

# Synthetic traffic, no network access. Same as the --mock flag.
# MOCK=aircraft:20000,ships:50000

# --- Logging -----------------------------------------------------------------

# text or json.
LOG_FORMAT=text
# Standard tracing filter, for example info or orya_halo_gateway=debug.
# RUST_LOG=info
