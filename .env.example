# Orya Halo web app configuration. Copy to apps/web/.env.local and edit.
# Nothing here is required: with no file at all the app runs every
# client-side layer and looks for a gateway on localhost in development.
#
# Anything prefixed VITE_ is compiled into the public bundle. Never put a
# secret in this file. Secret keys belong to the gateway: apps/gateway/.env.example

# WebSocket address of the realtime gateway (aircraft, ships, wildfires).
# Development default: ws://localhost:8787. Production default: none.
# Set to "off" to run without a gateway.
# VITE_GATEWAY_URL=wss://gateway.example.org

# Base map tiles for deep zoom. Zoom 0 to 5 always come from the bundled
# extract (run `pnpm --filter @orya-halo/web tiles` once). Pick one:
#   a) your own Protomaps planet archive on object storage
# VITE_PMTILES_URL=https://tiles.example.org/planet.pmtiles
#   b) the hosted Protomaps API (free for non-commercial use, key is public by design)
# VITE_PROTOMAPS_KEY=

# Rain layer provider: "rainviewer" (real radar, free for personal, educational
# and small community use) or "imerg" (NASA, fully open, several hours behind).
# VITE_RADAR_SOURCE=rainviewer

# Address of the project's repository, used for links on the About page
# (for example to docs/DATA_LICENCES.md). Optional.
# VITE_REPO_URL=https://github.com/your-name/orya-halo
